// =============================================================================
//  Claude 데스크탑 MCP 설정 파일 — 실습용 템플릿
//  제롬포인트자산관리대부 · Claude 실무교육
// =============================================================================
//
//  [0] 이 파일을 어디에 넣나
//  -------------------------------------------------------------------------
//  Microsoft Store 버전 Claude 데스크탑:
//    C:\Users\<<내윈도우계정>>\AppData\Local\Packages\Claude_pzs8sxrjxfjjc\LocalCache\Roaming\Claude\claude_desktop_config.json
//
//  일반 설치(.exe) 버전 Claude 데스크탑:
//    C:\Users\<<내윈도우계정>>\AppData\Roaming\Claude\claude_desktop_config.json
//
//  ※ 두 버전은 경로가 다릅니다. 내가 어느 버전인지 모르면 두 경로를 모두 열어보고
//    claude_desktop_config.json 이 이미 있는 쪽이 내 경로입니다.
//  ※ 저장할 때 파일 이름은 반드시 claude_desktop_config.json (확장자 .json)
//
//
//  [1] 쓰는 순서
//  -------------------------------------------------------------------------
//   1. 기존 claude_desktop_config.json 이 있으면 먼저 복사해서 백업
//   2. 이 파일에서 << >> 로 감싼 자리를 내 값으로 바꾼다
//   3. 안 쓸 MCP는 그 블록을 통째로 지운다 (많이 붙일수록 느려지고 비싸집니다)
//   4. VS Code 나 메모장++ 로 저장 — 인코딩은 UTF-8
//      ※ 윈도우 기본 메모장은 한글이 깨질 수 있으니 피하세요
//   5. Claude 데스크탑 완전 종료 (작업 표시줄 아이콘까지 종료) 후 재실행
//
//
//  [2] 사전에 깔려 있어야 하는 것 — 둘 다 없으면 MCP 가 하나도 안 뜹니다
//  -------------------------------------------------------------------------
//   MCP 는 두 종류입니다. "command" 값을 보면 무엇이 필요한지 알 수 있습니다.
//     "npx"        → Node.js 가 필요
//     "uvx" / "uv" → uv 가 필요 (파이썬으로 만든 MCP 를 대신 설치·실행해 줍니다)
//
//
//   (1) Node.js
//     https://nodejs.org/ko/download 에서 초록색 LTS 버튼으로 받고,
//     설치 중 선택지는 전부 기본값 그대로 두세요.
//
//
//   (2) uv  ★ 아래는 PowerShell 에서 실행합니다
//     시작 메뉴에 "powershell" 을 치면 Windows PowerShell 이 나옵니다.
//     프롬프트가  PS C:\Users\...>  로 시작하면 PowerShell 이 맞습니다.
//     아래 한 줄을 복사해 붙여넣고 엔터. (README.md 의 복사 버튼을 쓰면 안전합니다)
//
// irm https://astral.sh/uv/install.ps1 | iex
//
//
//   (3) 설치 확인 — PowerShell 창을 닫고 새로 연 다음
//     node -v        →  v22.x.x 처럼 버전이 나오면 성공
//     uv --version   →  uv 0.12.x 처럼 버전이 나오면 성공
//
//
//   자주 걸리는 세 가지
//     · "uv 를 찾을 수 없습니다"
//         설치 실패가 아니라 열려 있던 창이 옛 경로를 들고 있는 것입니다.
//         창을 닫고 새로 여세요. 그래도 안 되면 컴퓨터를 다시 시작하세요.
//     · "다른 프로세스에서 사용 중이므로 액세스할 수 없습니다"
//         이미 uv 가 깔려 있고 Claude 데스크탑이 그 파일을 쓰는 중입니다.
//         그대로 두셔도 됩니다. 굳이 최신으로 올리려면 Claude 를 완전 종료 후 재실행.
//     · Node.js 나 uv 를 새로 깔았다면
//         Claude 데스크탑을 완전 종료했다가 다시 켜야 인식합니다.
//         창만 닫지 마시고 작업 표시줄 우측 트레이 아이콘까지 종료하세요.
//
//
//  [3] 이 파일에 대한 중요한 경고
//  -------------------------------------------------------------------------
//   ★ 이 파일은 JSONC(주석 허용) 형식입니다. Claude 데스크탑이 주석을 못 읽고
//     오류를 낼 수 있습니다. 앱이 MCP를 하나도 못 읽으면 // 로 시작하는 줄을
//     전부 지우고 다시 저장하세요.
//   ★ API 키가 들어간 이 파일을 통째로 대화창에 붙여넣지 마세요.
//     필요한 줄만 골라서 보여주고, 키 자리는 ○○○ 로 가리세요.
//   ★ 이 파일을 GitHub·블로그·단톡방에 올릴 때는 << >> 자리표시자 상태인지
//     반드시 확인하세요. 실제 키가 들어간 채로 올리면 남이 내 돈을 씁니다.
//
// =============================================================================

{
  "mcpServers": {

    // =========================================================================
    //  A. API 키 불필요 — 설치만 되어 있으면 바로 작동
    // =========================================================================

    // -------------------------------------------------------------------------
    // youtube : 유튜브 영상·음성·자막 내려받기
    //   필요조건 : Node.js
    //   API 키   : 불필요
    // -------------------------------------------------------------------------
    "youtube": {
      "command": "npx",
      "args": [
        "-y",
        "@kevinwatt/yt-dlp-mcp@latest"
      ]
    },

    // -------------------------------------------------------------------------
    // youtube-transcript : 유튜브 자막만 빠르게 가져오기
    //   필요조건 : Node.js
    //   API 키   : 불필요
    // -------------------------------------------------------------------------
    "youtube-transcript": {
      "command": "npx",
      "args": [
        "-y",
        "@kimtaeyoon83/mcp-server-youtube-transcript"
      ]
    },

    // -------------------------------------------------------------------------
    // context7 : 라이브러리·프레임워크 공식 문서를 최신본으로 조회
    //   필요조건 : Node.js
    //   API 키   : 불필요 (무료 사용량 내)
    // -------------------------------------------------------------------------
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },

    // -------------------------------------------------------------------------
    // sequential-thinking : 복잡한 문제를 단계로 쪼개서 생각하게 하는 도구
    //   필요조건 : Node.js
    //   API 키   : 불필요
    // -------------------------------------------------------------------------
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },

    // -------------------------------------------------------------------------
    // playwright : 브라우저 자동화 (로그인이 필요한 사이트 조회 등)
    //   필요조건 : Node.js
    //   API 키   : 불필요
    //   ※ 최초 실행 시 브라우저 엔진을 자동으로 내려받습니다(수백 MB, 몇 분 소요)
    // -------------------------------------------------------------------------
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },

    // -------------------------------------------------------------------------
    // hwp-read : 한글(HWP/HWPX) 읽기·마크다운 변환·표 편집·서식·SVG 렌더 (도구 35개)
    //   필요조건 : Node.js 20 이상 (npx). 한컴오피스 설치 불필요
    //   API 키   : 불필요
    //   ※ 읽기는 .hwp/.hwpx 둘 다, 고쳐 쓰기는 .hwpx 만 됩니다.
    // -------------------------------------------------------------------------
    "hwp-read": {
      "command": "npx",
      "args": [
        "-y",
        "hwp-mcp@latest"
      ]
    },

    // -------------------------------------------------------------------------
    // word : 워드(.docx) 문서 작성·편집·서식·주석
    //   필요조건 : uv/uvx  (일부 기능은 Microsoft Word 설치 필요)
    //   API 키   : 불필요
    //   ※ MCP_AUTHOR 는 문서 작성자·주석 이름으로 찍힙니다. 본인 이름으로 바꾸세요.
    // -------------------------------------------------------------------------
    "word": {
      "command": "uvx",
      "args": [
        "--from",
        "word-mcp-live",
        "word_mcp_server.exe"
      ],
      "env": {
        "MCP_AUTHOR": "<<내이름_또는_회사명>>",
        "MCP_AUTHOR_INITIALS": "<<약칭>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },


    // =========================================================================
    //  B. API 키 입력 필요 — 아래 << >> 자리를 내 키로 바꿔야 작동
    // =========================================================================

    // -------------------------------------------------------------------------
    // firecrawl : 봇을 막는 웹사이트에서 본문을 긁어오기
    //   필요조건 : Node.js
    //
    //   ★ API 키 입력 필요 ★
    //   발급처 : https://firecrawl.dev  → 가입 → Dashboard → API Keys
    //   키 형태 : fc- 로 시작하는 문자열
    //   비용    : 무료 플랜 있음 (월 크레딧 제한)
    // -------------------------------------------------------------------------
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        // ↓↓↓ 여기에 본인 Firecrawl API 키를 넣으세요 ↓↓↓
        "FIRECRAWL_API_KEY": "<<여기에_FIRECRAWL_API_키_입력>>",

        // 아래는 재시도·경고 설정입니다. 그대로 두셔도 됩니다.
        "FIRECRAWL_RETRY_MAX_ATTEMPTS": "5",
        "FIRECRAWL_RETRY_INITIAL_DELAY": "2000",
        "FIRECRAWL_RETRY_MAX_DELAY": "30000",
        "FIRECRAWL_RETRY_BACKOFF_FACTOR": "3",
        "FIRECRAWL_CREDIT_WARNING_THRESHOLD": "2000",
        "FIRECRAWL_CREDIT_CRITICAL_THRESHOLD": "500"
      }
    },

    // -------------------------------------------------------------------------
    // datagokr : 공공데이터포털 종합 (부동산 실거래가·건축물대장·온비드 공매 등)
    //
    //   ★ 로컬 설치 경로 입력 필요 ★
    //   이 MCP 는 npx/uvx 로 자동 설치되지 않습니다.
    //   소스를 내 PC 에 먼저 내려받은 뒤, 그 폴더 경로를 아래 --directory 에
    //   이 교육에서는 C:\mcp\datagokr-mcp 에 두기로 통일했습니다.
    //   경로는 역슬래시 두 개(\\)로 적어야 합니다.
    //   필요조건 : uv/uvx  +  Python
    //
    //   ★ API 키 입력 필요 ★
    //   발급처 : https://www.data.go.kr  → 가입 → 원하는 API 마다 "활용신청"
    //   키 형태 : 64자리 영문+숫자 (Decoding 키를 쓰세요)
    //   비용    : 무료
    //   ※ 공공데이터포털은 API 별로 따로 신청해야 합니다.
    //   ※ EPOST_SERVICE_KEY(우편번호·주소 검색)도 같은 포털에서 발급합니다.
    //     같은 계정이면 보통 같은 키를 그대로 쓰면 됩니다.
    // -------------------------------------------------------------------------
    "datagokr": {
      "command": "uv",
      "args": [
        "--directory",
        "C:\\mcp\\datagokr-mcp",
        "run",
        "python",
        "server.py"
      ],
      "env": {
        // ↓↓↓ 여기에 공공데이터포털 서비스 키(Decoding)를 넣으세요 ↓↓↓
        "DATA_GO_KR_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",
        "EPOST_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",

        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },


    // =========================================================================
    //  경매 물건 분석용 4종  ―  아래 네 개가 경매 프로젝트의 준비물입니다
    //
    //  소스가 필요한 것은 전부 C:\mcp 아래에 둡니다. 전원이 같은 경로를 쓰면
    //  이 파일을 그대로 복사해 쓸 수 있습니다. 다른 곳에 두면 경로를 일일이
    //  고쳐야 합니다.
    //
    //      C:\mcp\datagokr-mcp
    //      C:\mcp\real-estate-mcp
    //      C:\mcp\vworld-landuse-mcp
    //
    //  korean-law 는 폴더가 필요 없습니다. npx 가 알아서 받아 실행합니다.
    // =========================================================================

    // -------------------------------------------------------------------------
    // korean-law : 국가법령정보센터 (법령·판례·조례)
    //
    //   ★ 설치 불필요 ★
    //   npx 가 자동으로 내려받습니다. 폴더도 경로도 필요 없습니다.
    //   첫 실행은 30초쯤 걸릴 수 있습니다. 그때 "연결 실패"가 떠도
    //   한 번 더 재시작하면 붙습니다.
    //
    //   ★ OC 입력 필요 ★
    //   발급처 : https://open.law.go.kr  → 로그인 → 오픈API 신청
    //   OC 는 보통 "가입한 이메일의 앞부분(아이디)" 입니다.
    //   비용   : 무료
    //
    //   안 붙이면 : 세율·법령을 기억에 의존하게 됩니다. 세법은 자주 바뀝니다.
    // -------------------------------------------------------------------------
    "korean-law": {
      "command": "npx",
      "args": ["-y", "korean-law-mcp"],
      "env": {
        // ↓↓↓ 여기에 국가법령정보센터 OC(이메일 아이디)를 넣으세요 ↓↓↓
        "LAW_OC": "<<여기에_법령센터_OC_입력>>"
      }
    },

    // -------------------------------------------------------------------------
    // real-estate : 국토교통부 실거래가 (아파트·단독·빌라·오피스텔 / 매매·전월세)
    //
    //   ★ 로컬 설치 경로 필요 ★
    //   받는 곳 : https://github.com/tae0y/real-estate-mcp
    //             초록색 Code 버튼 → Download ZIP → 압축 해제
    //             폴더 이름을 real-estate-mcp 로 맞춰 C:\mcp 아래 둡니다.
    //   필요조건 : uv  +  Python
    //
    //   ★ API 키 입력 필요 ★
    //   발급처 : https://www.data.go.kr  (공공데이터포털)
    //   ※ 필요한 키 이름과 신청할 서비스는 그 저장소의 README 를 따릅니다.
    //     아래 env 는 README 를 보고 채우세요.
    //
    //   안 붙이면 : 시세 대조를 못 합니다. 감정가가 적정한지 판단할 근거가
    //              사라집니다. 넷 중 가장 아쉬운 항목입니다.
    // -------------------------------------------------------------------------
    "real-estate": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\mcp\\real-estate-mcp",
        "python",
        "src/real_estate/mcp_server/server.py"
      ],
      "env": {
        // ↓↓↓ 저장소 README 가 요구하는 키 이름으로 바꿔 넣으세요 ↓↓↓
        "DATA_GO_KR_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",

        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },

    // -------------------------------------------------------------------------
    // vworld-landuse : 브이월드 (개별공시지가·용도지역·토지이용계획)
    //
    //   ★ 로컬 설치 경로 필요 ★
    //   받는 곳 : https://github.com/dgkim3333-hash/claude-guide-kr
    //             → 경매물건분석/mcp/vworld-landuse-mcp 폴더
    //             그 폴더를 C:\mcp\vworld-landuse-mcp 로 복사합니다.
    //   필요조건 : uv  +  Python
    //
    //   ★ 인증키 입력 필요 ★
    //   발급처 : https://www.vworld.kr
    //            마이포털 → 나의 오픈API → 인증키 관리 → 인증키 발급하기
    //            활용 용도에서 "부동산토지이용계획조회" 를 고르세요.
    //   비용   : 무료
    //
    //   ※ 개발키는 유효기간이 6개월입니다. 최대 3회 연장되니 최장 2년입니다.
    //     만료 전에 연장하세요. 지나면 새로 발급받아야 합니다.
    //   ※ 키는 각자 발급받으세요. 남의 키를 같이 쓰면 호출 한도를 같이 씁니다.
    //
    //   안 붙이면 : 공시지가·용도지역을 못 봅니다. 토지이용규제정보서비스에서
    //              눈으로 확인해 알려주면 대신할 수 있습니다.
    // -------------------------------------------------------------------------
    "vworld-landuse": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\mcp\\vworld-landuse-mcp",
        "python",
        "vworld_landuse_mcp.py"
      ],
      "env": {
        // ↓↓↓ 여기에 브이월드 인증키를 넣으세요 ↓↓↓
        "VWORLD_API_KEY": "<<여기에_브이월드_인증키_입력>>",

        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },

    // -------------------------------------------------------------------------
    // kis : 한국투자증권 오픈API (시세·잔고·주문 조회)
    //
    //   ★ 로컬 설치 경로 입력 필요 ★
    //   이 MCP 도 자동 설치되지 않습니다. 소스를 내 PC 에 먼저 내려받고
    //   그 폴더 경로를 아래 --directory 에 적으세요. (예: C:\mcp\KIS_MCP_Server)
    //   필요조건 : uv/uvx  +  Python
    //
    //   ★ API 키 입력 필요 ★
    //   발급처 : https://apiportal.koreainvestment.com
    //            → 한국투자증권 계좌 개설 후 로그인 → "KIS Developers" 신청
    //   비용   : 무료 (증권 계좌는 실제로 있어야 합니다)
    //
    //   ★★ 반드시 읽어주세요 ★★
    //   · KIS_ACCOUNT_TYPE 은 처음에는 반드시 "VIRTUAL"(모의투자)로 두세요.
    //     "REAL" 은 실제 계좌·실제 돈입니다.
    //   · APP_SECRET 과 계좌번호가 새면 금전 피해로 바로 이어집니다.
    //     이 파일을 절대 대화창·깃허브·단톡방에 그대로 올리지 마세요.
    //   · 주식 트랙이 아니면 이 블록은 통째로 지우세요.
    // -------------------------------------------------------------------------
    "kis": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "<<KIS_MCP_Server_소스를_받은_폴더_경로>>",
        "python",
        "server.py"
      ],
      "env": {
        // ↓↓↓ 여기에 한국투자증권 앱키·시크릿·계좌번호를 넣으세요 ↓↓↓
        "KIS_APP_KEY": "<<여기에_KIS_APP_KEY_입력>>",
        "KIS_APP_SECRET": "<<여기에_KIS_APP_SECRET_입력>>",
        "KIS_CANO": "<<여기에_계좌번호_앞8자리_입력>>",
        "KIS_ACNT_PRDT_CD": "01",

        // "VIRTUAL" = 모의투자 / "REAL" = 실계좌. 처음에는 VIRTUAL 로 두세요.
        "KIS_ACCOUNT_TYPE": "VIRTUAL",

        "KIS_MCP_TOOLSET": "catalog",
        "KIS_MCP_LOG_LEVEL": "WARNING",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }

  }
}
