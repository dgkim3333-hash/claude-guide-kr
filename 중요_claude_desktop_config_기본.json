{
  "mcpServers": {
    "youtube": {
      "command": "npx",
      "args": [
        "-y",
        "@kevinwatt/yt-dlp-mcp@latest"
      ]
    },
    "youtube-transcript": {
      "command": "npx",
      "args": [
        "-y",
        "@kimtaeyoon83/mcp-server-youtube-transcript"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "hwp-read": {
      "command": "npx",
      "args": [
        "-y",
        "hwp-mcp@latest"
      ]
    },
    "word": {
      "command": "uvx",
      "args": [
        "--from",
        "word-mcp-live",
        "word_mcp_server.exe"
      ],
      "env": {
        "MCP_AUTHOR": "Claude",
        "MCP_AUTHOR_INITIALS": "C",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "datagokr": {
      "command": "uv",
      "args": [
        "--directory",
        "C:\\AI\\mcp\\datagokr-mcp",
        "run",
        "python",
        "server.py"
      ],
      "env": {
        "DATA_GO_KR_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",
        "EPOST_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }
  }
}
