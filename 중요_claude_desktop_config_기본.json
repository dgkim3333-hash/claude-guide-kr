{
  "mcpServers": {
    "youtube": {
      "command": "npx",
      "args": ["-y", "@kevinwatt/yt-dlp-mcp@latest"]
    },
    "youtube-transcript": {
      "command": "npx",
      "args": ["-y", "@kimtaeyoon83/mcp-server-youtube-transcript"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "hwp-read": {
      "command": "npx",
      "args": ["-y", "hwp-mcp@latest"]
    },
    "word": {
      "command": "uvx",
      "args": ["--from", "word-mcp-live", "word_mcp_server.exe"],
      "env": {
        "MCP_AUTHOR": "Claude",
        "MCP_AUTHOR_INITIALS": "C",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "<<여기에_FIRECRAWL_API_키_입력>>",
        "FIRECRAWL_RETRY_MAX_ATTEMPTS": "5",
        "FIRECRAWL_RETRY_INITIAL_DELAY": "2000",
        "FIRECRAWL_RETRY_MAX_DELAY": "30000",
        "FIRECRAWL_RETRY_BACKOFF_FACTOR": "3",
        "FIRECRAWL_CREDIT_WARNING_THRESHOLD": "2000",
        "FIRECRAWL_CREDIT_CRITICAL_THRESHOLD": "500"
      }
    },
    "korean-law": {
      "command": "npx",
      "args": ["-y", "korean-law-mcp"],
      "env": {
        "LAW_OC": "<<여기에_법령센터_OC_입력>>"
      }
    },
    "real-estate": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\AI\\mcp\\real-estate-mcp",
        "python",
        "src/real_estate/mcp_server/server.py"
      ],
      "env": {
        "DATA_GO_KR_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "datagokr": {
      "command": "uv",
      "args": [
        "--directory",
        "C:\\AI\\mcp\\datagokr-mcp",
        "run",
        "python",
        "server.py"
      ],
      "env": {
        "DATA_GO_KR_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",
        "EPOST_SERVICE_KEY": "<<여기에_공공데이터포털_API_키_입력>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "vworld-landuse": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\AI\\mcp\\vworld-landuse-mcp",
        "python",
        "vworld_landuse_mcp.py"
      ],
      "env": {
        "VWORLD_API_KEY": "<<여기에_브이월드_인증키_입력>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "kis": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:\\AI\\mcp\\kis-mcp-server",
        "python",
        "server.py"
      ],
      "env": {
        "KIS_APP_KEY": "<<여기에_KIS_APP_KEY_입력>>",
        "KIS_APP_SECRET": "<<여기에_KIS_APP_SECRET_입력>>",
        "KIS_CANO": "<<여기에_계좌번호_앞8자리_입력>>",
        "KIS_ACNT_PRDT_CD": "01",
        "KIS_ACCOUNT_TYPE": "VIRTUAL",
        "KIS_MCP_TOOLSET": "catalog",
        "KIS_MCP_LOG_LEVEL": "WARNING",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<<여기에_GitHub_개인액세스토큰_입력>>"
      }
    }
  }
}
